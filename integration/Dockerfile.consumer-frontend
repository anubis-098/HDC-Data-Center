# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /app
COPY --from=consumer_source package*.json ./
RUN npm ci
COPY --from=consumer_source . .
COPY HdcStores.tsx ./src/components/HdcStores.tsx
COPY StorePicker.tsx ./src/components/StorePicker.tsx
COPY StorePicker.css ./src/components/StorePicker.css
COPY patch-frontend.cjs /tmp/patch-frontend.cjs
ARG HDC_CONSUMER_TYPE
RUN node /tmp/patch-frontend.cjs "$HDC_CONSUMER_TYPE" && npm run build
FROM nginx:stable-alpine
COPY --from=build /app/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
